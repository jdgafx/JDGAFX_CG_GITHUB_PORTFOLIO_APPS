    {
      "id": "1b2d4bb4-9a39-4237-bbe9-635ea9178a4b",
      "name": "sn1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -220,
        60
      ],
      "parameters": {
        "content": "## Adapter: Target Upsert\nSingle-attempt idempotent write to the target system.\n\n**Idempotency:** check-before-write by externalId (upsert).\n**Conflict resolution:** last-write-wins by sourceUpdatedAt; both versions logged to sync_conflicts.\n**Failure simulation:** simulateFailure=true throws — caller (main workflow) handles retry/backoff/DLQ.\n\nThis sub-workflow does ONE attempt only and is stateless — called repeatedly by the main workflow's retry loop.",
        "height": 260,
        "width": 620,
        "color": 6
      }
    },
    {
      "id": "07628870-4409-43b6-9deb-89f840137f7e",
      "name": "sn2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        600,
        780
      ],
      "parameters": {
        "content": "**Conflict rule:**\nexisting row found -> conflict=true.\nincoming.sourceUpdatedAt >= existing.sourceUpdatedAt -> incoming wins (normal propagation / newer edit wins).\nincoming.sourceUpdatedAt < existing.sourceUpdatedAt -> existing wins, incoming version rejected as stale.\nBoth versions always written to sync_conflicts when a prior row existed.",
        "height": 200,
        "width": 460,
        "color": 5
      }
    }
  ],
