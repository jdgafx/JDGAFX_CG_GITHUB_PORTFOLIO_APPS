      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const decision = $('Resolve Conflict & Decide Write').item.json;\nconst written = $input.first().json;\nreturn [{ json: {\n  success: true,\n  action: decision.action,\n  conflict: decision.conflict,\n  externalId: decision.externalId,\n  targetSystem: decision.targetSystem,\n  sourceSystem: decision.sourceSystem,\n  idempotencyKey: decision.idempotencyKey,\n  before: decision.existing,\n  after: written,\n} }];"
      }
