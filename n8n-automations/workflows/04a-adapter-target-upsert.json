    {
      "id": "21776ba9-795f-4910-9939-ae06918fd2f6",
      "name": "Resolve Conflict & Decide Write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const trigger = $('When Called by Sync Workflow').item.json;\nconst existingRows = $('Lookup Target Row').all().map(i => i.json).filter(r => r && r.id !== undefined);\nconst existing = existingRows.length > 0 ? existingRows[0] : null;\nconst incoming = trigger.contact;\nconst targetSystem = trigger.targetSystem;\nconst sourceSystem = trigger.sourceSystem;\nconst idempotencyKey = trigger.idempotencyKey;\n\nlet conflict = false;\nlet action;\nlet winner;\nlet loser = null;\n\nif (!existing) {\n  action = 'insert';\n  winner = incoming;\n} else {\n  conflict = true;\n  const incomingTs = incoming.sourceUpdatedAt;\n  const existingTs = existing.sourceUpdatedAt;\n  if (incomingTs >= existingTs) {\n    winner = incoming;\n    loser = existing;\n    action = 'update';\n  } else {\n    winner = existing;\n    loser = incoming;\n    action = 'rejected-stale';\n  }\n}\n\nconst writeNeeded = action !== 'rejected-stale';\n\nreturn [{\n  json: {\n    targetSystem, sourceSystem, idempotencyKey,\n    externalId: incoming.externalId,\n    conflict, action, writeNeeded,\n    existing, incoming, winner, loser,\n  },\n}];"
      }
    },
