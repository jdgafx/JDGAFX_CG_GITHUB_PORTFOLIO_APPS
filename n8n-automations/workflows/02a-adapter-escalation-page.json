        "mode": "runOnceForAllItems",
        "jsCode": "// The SLA clock starts the moment the page is raised, not when a human opens it.\nconst item = $json;\nconst minutes = Number(item.sla_minutes ?? 60);\nconst now = new Date();\nconst due = new Date(now.getTime() + minutes * 60 * 1000);\n\nreturn [{\n  json: {\n    ...item,\n    paged_at: now.toISOString(),\n    sla_due_at: due.toISOString(),\n    sla_minutes: minutes,\n    status: 'paged',\n  },\n}];"
      },
