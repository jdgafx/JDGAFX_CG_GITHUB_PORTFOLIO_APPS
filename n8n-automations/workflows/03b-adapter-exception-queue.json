        "language": "javaScript",
        "jsCode": "const row = $json;\nlet reasons = [];\ntry { reasons = JSON.parse(row.reasons || '[]'); } catch (e) { reasons = [String(row.reasons || '')]; }\nreturn [{ json: {\n  queued: true,\n  exceptionRef: String(row.id ?? ''),\n  sink: 'n8n Data Table: ap_exceptions (demo sink for the AP exception desk)',\n  invoiceId: row.invoiceId,\n  stage: row.stage,\n  reasons,\n  reasonCount: reasons.length,\n  raisedAt: row.raisedAt,\n} }];"
