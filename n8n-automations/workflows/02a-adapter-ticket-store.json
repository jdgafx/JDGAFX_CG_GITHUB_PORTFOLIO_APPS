        "mode": "runOnceForAllItems",
        "jsCode": "// The adapter returns a receipt, never the raw sink response, so the caller is\n// decoupled from whichever ticketing system sits behind this boundary.\nconst row = $json;\nreturn [{\n  json: {\n    stored: true,\n    sink: 'n8n Data Table: triage_tickets (demo sink)',\n    ticket_id: row.ticket_id,\n    row_id: row.id ?? null,\n    stored_at: new Date().toISOString(),\n  },\n}];"
