      }
    },
    {
      "id": "ca718306-d83a-498c-916c-e721b41529cf",
      "name": "Get History (kpi_history)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        40,
        340
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "kpi_history"
        },
        "returnAll": false,
        "limit": 90,
        "orderBy": true,
        "orderByColumn": "createdAt",
        "orderByDirection": "DESC",
