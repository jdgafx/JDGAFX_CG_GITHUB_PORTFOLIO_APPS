      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst isWebhook = item.headers !== undefined && item.body !== undefined;\nconst testOverrides = (isWebhook && item.body && item.body.testOverrides) || {};\nreturn [{\n  json: {\n    triggerSource: isWebhook ? 'webhook' : 'schedule',\n    runTimestamp: new Date().toISOString(),\n    testOverrides,\n  }\n}];\n"
      }
    },
