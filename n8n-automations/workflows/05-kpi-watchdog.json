    {
      "id": "0e76bb9c-9923-435e-b88a-515a923de0b3",
      "name": "Build Digest Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        340
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const metrics = $('Detect Anomalies').all().map(i => i.json);\nconst ctx = $('Aggregate Metrics').first().json;\nconst anomalyCount = metrics.filter(m => m.anomaly).length;\nconst sourceDownCount = metrics.filter(m => !m.ok).length;\n\nconst lines = metrics.map(m => {\n  if (!m.ok) return `- ${m.metric_name}: SOURCE UNAVAILABLE (${m.error_note})`;\n  const trend = m.pct_change === null ? 'no prior history yet' : `${m.pct_change >= 0 ? '+' : ''}${m.pct_change.toFixed(1)}% vs rolling mean of ${m.prior_count} prior run(s)`;\n  return `- ${m.metric_name}: ${m.value} (${trend})${m.anomaly ? '  <-- ANOMALY (threshold ' + m.threshold_pct + '%)' : ''}`;\n}).join('\\n');\n\nconst prompt = `You are writing a crisp executive KPI digest for a portfolio automation demo.\\n\\nRun timestamp: ${ctx.runTimestamp}\\nTrigger: ${ctx.triggerSource}\\n\\nMetrics this run:\\n${lines}\\n\\nWrite a short executive digest (120-180 words, plain text, no markdown headers) that:\\n1. States what moved and by how much, in plain business language.\\n2. Explicitly calls out any ANOMALY metrics by name and explains why it matters.\\n3. If any source is unavailable, say so plainly as a data-gap note - never silently omit it.\\n4. Ends with one sentence on overall system health (normal / needs attention).\\nDo not invent numbers that were not given above.`;\n\nreturn [{ json: {\n  prompt,\n  runTimestamp: ctx.runTimestamp,\n  anomalyCount,\n  sourceDownCount,\n  metricsJson: JSON.stringify(metrics),\n}}];\n"
      }
    },
    {
