    {
      "id": "3a703352-5c78-4f3e-8acb-67f0c93ec663",
      "name": "Detect Anomalies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        340
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const THRESHOLD_PCT = 15; // % deviation from rolling mean that counts as an anomaly\nconst MIN_HISTORY = 1;    // need at least this many prior runs to judge\nconst current = $('Aggregate Metrics').first().json;\nconst historyRows = $input.all().map(i => i.json);\n\nconst out = current.metrics.map(m => {\n  const prior = historyRows\n    .filter(r => r.metric_name === m.metric && typeof r.value === 'number')\n    .map(r => r.value);\n  const priorCount = prior.length;\n  const priorMean = priorCount ? prior.reduce((a, b) => a + b, 0) / priorCount : null;\n  let pctChange = null;\n  let anomaly = false;\n  if (m.ok && priorCount >= MIN_HISTORY && priorMean) {\n    pctChange = ((m.value - priorMean) / priorMean) * 100;\n    anomaly = Math.abs(pctChange) >= THRESHOLD_PCT;\n  }\n  return {\n    metric_name: m.metric,\n    source: m.source,\n    value: m.ok ? m.value : null,\n    ok: m.ok,\n    error_note: m.error || '',\n    run_timestamp: current.runTimestamp,\n    prior_mean: priorMean,\n    prior_count: priorCount,\n    pct_change: pctChange,\n    anomaly,\n    threshold_pct: THRESHOLD_PCT,\n  };\n});\nreturn out.map(json => ({ json }));\n"
      }
    },
