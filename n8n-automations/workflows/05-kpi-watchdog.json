    {
      "id": "b51056db-b2d2-45b0-8179-d9e6f80b376f",
      "name": "Normalize GitHub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        220
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst overrides = ($('Init Context').first().json.testOverrides || {}).overrides || {};\nlet ok = true, value = null, error = null;\nif (raw && raw.error) {\n  ok = false;\n  error = typeof raw.error === 'string' ? raw.error : (raw.error.message || JSON.stringify(raw.error));\n} else {\n  try {\n    value = raw.stargazers_count;\n    if (value === undefined || value === null || Number.isNaN(Number(value))) throw new Error('missing/invalid field in response');\n    value = Number(value);\n  } catch (e) {\n    ok = false;\n    error = e.message;\n  }\n}\nif (overrides['github_stars'] !== undefined) {\n  value = Number(overrides['github_stars']);\n  ok = true; error = null;\n}\nreturn [{ json: {\n  source: 'github',\n  metric: 'github_stars',\n  value, ok, error,\n}}];\n"
      }
    },
    {
      "id": "46c25610-f22e-41e1-850b-12d2cf8c3697",
      "name": "Normalize CoinGecko",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        340
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst overrides = ($('Init Context').first().json.testOverrides || {}).overrides || {};\nlet ok = true, value = null, error = null;\nif (raw && raw.error) {\n  ok = false;\n  error = typeof raw.error === 'string' ? raw.error : (raw.error.message || JSON.stringify(raw.error));\n} else {\n  try {\n    value = raw.bitcoin.usd;\n    if (value === undefined || value === null || Number.isNaN(Number(value))) throw new Error('missing/invalid field in response');\n    value = Number(value);\n  } catch (e) {\n    ok = false;\n    error = e.message;\n  }\n}\nif (overrides['btc_price_usd'] !== undefined) {\n  value = Number(overrides['btc_price_usd']);\n  ok = true; error = null;\n}\nreturn [{ json: {\n  source: 'coingecko',\n  metric: 'btc_price_usd',\n  value, ok, error,\n}}];\n"
      }
    },
    {
      "id": "1fb0ed97-7c9a-47ca-b735-d67088f49bd2",
      "name": "Normalize Open-Meteo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        460
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst overrides = ($('Init Context').first().json.testOverrides || {}).overrides || {};\nlet ok = true, value = null, error = null;\nif (raw && raw.error) {\n  ok = false;\n  error = typeof raw.error === 'string' ? raw.error : (raw.error.message || JSON.stringify(raw.error));\n} else {\n  try {\n    value = raw.current.temperature_2m;\n    if (value === undefined || value === null || Number.isNaN(Number(value))) throw new Error('missing/invalid field in response');\n    value = Number(value);\n  } catch (e) {\n    ok = false;\n    error = e.message;\n  }\n}\nif (overrides['boston_temp_c'] !== undefined) {\n  value = Number(overrides['boston_temp_c']);\n  ok = true; error = null;\n}\nreturn [{ json: {\n  source: 'openmeteo',\n  metric: 'boston_temp_c',\n  value, ok, error,\n}}];\n"
      }
    },
