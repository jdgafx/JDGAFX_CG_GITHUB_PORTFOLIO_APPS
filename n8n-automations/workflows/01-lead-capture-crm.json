    {
      "parameters": {
        "jsCode": "const lead = $('Prepare Lead').item.json;\nconst llm = $json.output ?? $json;\nconst score = Math.max(1, Math.min(100, Math.round(Number(llm.score) || 1)));\nreturn [{\n  json: {\n    ...lead,\n    companySize: llm.companySize || 'unknown',\n    industry: llm.industry || 'unknown',\n    score,\n    reasoning: llm.reasoning || '',\n    routed: score >= 70 ? 'hot' : 'standard'\n  }\n}];"
      },
