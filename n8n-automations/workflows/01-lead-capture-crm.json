    {
      "parameters": {
        "jsCode": "function fnv1a(str) {\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    hash ^= str.charCodeAt(i);\n    hash = Math.imul(hash, 0x01000193);\n  }\n  return (hash >>> 0).toString(16).padStart(8, '0');\n}\n\nconst email = ($json.email || '').trim().toLowerCase();\nconst domain = email.includes('@') ? email.split('@')[1] : '';\n// deterministic idempotency key: same email always maps to the same leadId,\n// so duplicate submissions resolve to the existing record instead of a new one.\nconst leadId = 'lead_' + fnv1a(email);\nconst message = $json.message || '';\n\n// Deliberate fault-injection test hook (documented in docs/01-lead-capture-crm.md):\n// lets us prove the shared [CORE] Error Handler wiring with a real execution\n// failure, without weakening validation for real traffic.\nif (message.includes('__FORCE_TEST_ERROR__')) {\n  throw new Error('Forced test error (fault-injection hook) to verify [CORE] Error Handler wiring');\n}\n\nreturn [{\n  json: {\n    ...$json,\n    email,\n    domain,\n    leadId\n  }\n}];"
      },
