      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst errors = [];\nconst required = ['name', 'email', 'company', 'message'];\nfor (const field of required) {\n  const v = body[field];\n  if (typeof v !== 'string' || !v.trim()) {\n    errors.push(`Missing or invalid field: ${field}`);\n  }\n}\nconst emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (typeof body.email === 'string' && body.email.trim() && !emailRe.test(body.email.trim())) {\n  errors.push('Invalid email format');\n}\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    name: body.name,\n    email: body.email,\n    company: body.company,\n    message: body.message,\n    source: (typeof body.source === 'string' && body.source.trim()) ? body.source.trim() : 'unknown'\n  }\n}];"
      },
