      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"companySize\": {\n      \"type\": \"string\",\n      \"enum\": [\"startup (1-10)\", \"small (11-50)\", \"medium (51-200)\", \"large (201-1000)\", \"enterprise (1000+)\"]\n    },\n    \"industry\": { \"type\": \"string\", \"description\": \"Short industry/vertical label, e.g. 'B2B SaaS', 'Healthcare', 'E-commerce'\" },\n    \"score\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"description\": \"Lead sales-readiness score, 1 (poor fit) to 100 (excellent, ready to buy)\" },\n    \"reasoning\": { \"type\": \"string\", \"description\": \"1-2 sentence justification for the score\" }\n  },\n  \"required\": [\"companySize\", \"industry\", \"score\", \"reasoning\"]\n}"
      },
